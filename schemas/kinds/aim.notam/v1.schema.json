{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:aim:notam:v1",
  "title": "Payload: NOTAM v1",
  "description": "Payload for kind aim.notam. Items B/C map to start/end_datetime, the area to the envelope geometry (circles as polygons); the original text or AIXM goes in assets.",
  "type": "object",
  "required": [
    "notam_id",
    "notam_type",
    "location",
    "q_code",
    "text",
    "altitude_lower",
    "altitude_upper"
  ],
  "additionalProperties": false,
  "properties": {
    "notam_id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{4}/[0-9]{2}$",
      "description": "Series, number, year, e.g. A1234/26"
    },
    "notam_type": {
      "enum": [
        "NOTAMN",
        "NOTAMR",
        "NOTAMC"
      ],
      "description": "New, replace, cancel"
    },
    "replaces": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][0-9]{4}/[0-9]{2}$"
    },
    "fir": {
      "type": "string",
      "pattern": "^[A-Z]{4}$"
    },
    "location": {
      "type": "string",
      "pattern": "^[A-Z]{4}$",
      "description": "Item A, ICAO location indicator"
    },
    "q_code": {
      "type": "string",
      "pattern": "^Q[A-Z]{4}$"
    },
    "traffic": {
      "type": "string",
      "pattern": "^[IVK]{1,2}$"
    },
    "purpose": {
      "type": "string",
      "pattern": "^[NBOMK]{1,3}$"
    },
    "scope": {
      "type": "string",
      "pattern": "^[AEWK]{1,2}$"
    },
    "schedule": {
      "type": [
        "string",
        "null"
      ],
      "description": "Item D"
    },
    "text": {
      "type": "string",
      "description": "Item E"
    },
    "altitude_lower": {
      "$ref": "urn:schema:fabric:common:v1#/$defs/altitude"
    },
    "altitude_upper": {
      "$ref": "urn:schema:fabric:common:v1#/$defs/altitude"
    },
    "area": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Original circle definition, kept because the envelope geometry is a polygon approximation",
      "properties": {
        "center": {
          "$ref": "urn:schema:fabric:common:v1#/$defs/lon_lat"
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius_units": {
          "enum": [
            "NM",
            "M",
            "KM"
          ]
        }
      }
    }
  }
}
