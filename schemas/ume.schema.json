        "ZMB",
        "ZWE",
        "ACGU",
        "FVEY",
        "NATO"
      ]
    },
    "umeProperties": {
      "type": "object",
      "required": [
        "ume_version",
        "kind",
        "schema",
        "datetime",
        "times",
        "geometry_source",
        "source",
        "provenance",
        "security",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "ume_version": {
          "const": "1"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "description": "Registered semantic type, e.g. track.fused, video.segment."
        },
        "schema": {
          "type": "string",
          "pattern": "^urn:schema:[a-z0-9_.:-]+$"
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^urn:",
          "description": "The thing this record is about (a track, alert, operational intent, sensor, zone). Records sharing an entity_id form its history; the latest-state projection is keyed on it. Whether it is required is set per kind."
        },
        "datetime": {
          "$ref": "#/$defs/dateTime",
          "description": "When the event happened. For spans, equals start_datetime."
        },
        "start_datetime": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "end_datetime": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "time_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "event",
            "source_at",
            null
          ]
        },
        "times": {
          "$ref": "#/$defs/times"
        },
        "expires_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "geometry_source": {
          "description": "Where the geometry came from; null when geometry is null.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "observed",
            "defined",
            "sensor_coverage",
            "sensor",
            "aoi",
            null
          ]
        },
        "position_error_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Horizontal 95% position error radius, metres."
        },
        "domain": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "AIR",
            "LAND",
            "SEA_SURFACE",
            "SUBSURFACE",
            "SPACE",
            null
          ]
        },
        "vertical_approximate": {
          "type": "boolean",
          "description": "True when heights (z or a geometry's vertical_extent) were converted using assumptions, e.g. flight levels via the standard atmosphere."
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "security": {
          "$ref": "#/$defs/security"
        },
        "payload": {
          "type": "object",
          "description": "Type-specific content, validated against properties.schema."
        }
      },
      "allOf": [
        {
          "description": "An end time requires a start time. A start without an end is an open-ended span.",
          "if": {
            "required": [
              "end_datetime"
            ],
            "properties": {
              "end_datetime": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "start_datetime"
            ],
            "properties": {
              "start_datetime": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "times": {
      "type": "object",
      "required": [
        "received_at"
      ],
      "additionalProperties": false,
      "description": "Pipeline timestamps for latency analysis.",
      "properties": {
        "source_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "sent_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "received_at": {
          "$ref": "#/$defs/dateTime"
        },
        "stored_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "node",
        "event_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:source:[a-z0-9_.-]+$",
          "description": "Stable identity of the device or producing service. Does not change when it moves between nodes."
        },
        "node": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "description": "Node that ingested or produced this record."
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identity of the source event, unique per source.id. Derived from source-native data (message ID, sequence, or a content hash) so that every node or adapter receiving the same event produces the same value. (source.id, kind, event_id) is the deduplication key; kind is included because one source event can yield several records of different kinds."
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin",
        "derived_from",
        "produced_by",
        "producer_org"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^urn:source:",
          "description": "Sensor or service the data first came from; a shortcut so lineage need not be followed through derived_from. Equals source.id for first-hand records. For derived records, the main input source (the producer picks one when several contribute equally; derived_from holds the full set). Always a system, never a person (see creator)."
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuidUrn"
          },
          "uniqueItems": true,
          "description": "Canonical lineage. STAC/PROV links and the ume_link index are generated from this."
        },
        "revision_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuidUrn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only when this record corrects or supersedes an earlier record. Not for new observations or state transitions."
        },
        "produced_by": {
          "type": "string",
          "minLength": 1
        },
        "producer_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer_org": {
          "$ref": "#/$defs/orgUrn"
        },
        "creator": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^urn:user:[a-z0-9_.-]+:[a-z0-9_.-]+$",
          "description": "Person who caused the record (Dublin Core creator; PROV attributed agent), e.g. the operator who issued a command or drew a measurement. Null or absent for records generated by sensors and services. source.id stays the device or service (e.g. the console) that generated the record.",
          "x-personal-info": true
        },
        "config_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/multihash"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "security": {
      "description": "Security label. The UME carries labels; it does not define their meaning or ordering. The policy package for each policy defines validation, clearance comparison, release, caveat handling, derivation and downgrade rules. Unlabeled records are rejected.",
      "type": "object",
      "required": [
        "policy",
        "classification",
        "releasable_to",
        "caveats",
        "originator"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": [
            "NATO",
            "CAN",
            "CORP"
          ]
        },
        "classification": {
          "type": "string"
        },
        "releasable_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "originator": {
          "$ref": "#/$defs/orgUrn",
          "description": "Controlling authority: who approves release or downgrade. Not necessarily the producer (see provenance.producer_org)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "NATO"
              }
            }
          },
          "then": {
            "properties": {
              "classification": {
                "enum": [
                  "NATO UNCLASSIFIED",
                  "NATO RESTRICTED",
                  "NATO CONFIDENTIAL",
                  "NATO SECRET",
                  "COSMIC TOP SECRET"
                ]
              },
              "releasable_to": {
                "items": {
                  "$ref": "#/$defs/countryOrCoalition"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "CAN"
              }
            }
          },
          "then": {
            "properties": {
              "classification": {
                "enum": [
                  "UNCLASSIFIED",
                  "PROTECTED A",
                  "PROTECTED B",
                  "PROTECTED C",
                  "CONFIDENTIAL",
                  "SECRET",
                  "TOP SECRET"
                ]
              },
              "releasable_to": {
                "items": {
                  "$ref": "#/$defs/countryOrCoalition"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "CORP"
              }
            }
          },
          "then": {
            "properties": {
              "classification": {
                "enum": [
                  "PUBLIC",
                  "INTERNAL",
                  "CONFIDENTIAL",
                  "RESTRICTED"
                ]
              },
              "releasable_to": {
                "items": {
                  "$ref": "#/$defs/orgUrn"
                }
              }
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "required": [
        "rel",
        "href"
      ],
      "additionalProperties": false,
      "description": "Stored links to services and related resources only. Files are assets; lineage is provenance; self/next/prev/derived_from links are generated by the access layer.",
      "properties": {
        "rel": {
          "enum": [
            "service",
            "related",
            "alternate",
            "describedby"
          ]
        },
        "href": {
          "$ref": "#/$defs/internalRef"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "href",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "href": {
          "$ref": "#/$defs/internalRef"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "file:size": {
          "type": "integer",
          "minimum": 0
        },
        "file:checksum": {
          "$ref": "#/$defs/multihash"
        }
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number"
        }
      ],
      "description": "[lon, lat] or [lon, lat, h], interpreted in the record's coordRefSys (CRS84h: WGS-84 degrees, h in metres above the ellipsoid). All positions in one geometry must have the same dimension (validator rule R10)."
    },
    "linearRing": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/position"
      },
      "description": "First and last positions must be equal (checked by the validator)."
    },
    "point": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "multiPoint": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiPoint"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      }
    },
    "lineString": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/position"
          }
        }
      }
    },
    "multiLineString": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiLineString"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/position"
            }
          }
        }
      }
    },
    "polygon": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linearRing"
          }
        },
        "vertical_extent": {
          "$ref": "#/$defs/verticalExtent"
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/linearRing"
            }
          }
        },
        "vertical_extent": {
          "$ref": "#/$defs/verticalExtent"
        }
      }
    },
    "geometryCollection": {
      "type": "object",
      "required": [
        "type",
        "geometries"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "GeometryCollection"
        },
        "geometries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/simpleGeometry"
          }
        }
      }
    },
    "simpleGeometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "$ref": "#/$defs/multiPoint"
        },
        {
          "$ref": "#/$defs/lineString"
        },
        {
          "$ref": "#/$defs/multiLineString"
        },
        {
          "$ref": "#/$defs/polygon"
        },
        {
          "$ref": "#/$defs/multiPolygon"
        }
      ]
    },
    "geometry": {
      "description": "GeoJSON-style geometry, 2D or 3D, or null for non-spatial kinds. A volume is a 2D Polygon or MultiPolygon footprint with a vertical_extent member.",
      "oneOf": [
        {
