{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:schema:fabric:ume:v1",
  "title": "Universal Metadata Envelope (UME) v1 — JSON profile",
  "description": "Normative JSON representation of a Data Fabric record. The layout (id, geometry, properties) and geometry objects follow GeoJSON (RFC 7946) practice, but a record is not itself a GeoJSON Feature; downstream services convert to GeoJSON (or JSON-FG, e.g. a Prism for volumes) for visualization. Every record states its coordRefSys. A volume is a 2D Polygon or MultiPolygon carrying a vertical_extent (lower, upper) member. The logical model is independent of this profile; Protobuf and SQL are other representations. The payload is validated separately against the schema named in properties.schema. Cross-field rules are checked by tools/validate.py.",
  "type": "object",
  "required": [
    "id",
    "geometry",
    "coordRefSys",
    "properties"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/uuidV7Urn"
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    },
    "coordRefSys": {
      "enum": [
        "http://www.opengis.net/def/crs/OGC/0/CRS84h"
      ],
      "description": "Coordinate reference system of every position in geometry and of any vertical_extent on it. CRS84h: lon, lat in degrees (WGS-84), height in metres above the WGS-84 ellipsoid. Required so each record states its CRS; further CRSs are added to this enum."
    },
    "properties": {
      "$ref": "#/$defs/umeProperties"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "default": []
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      },
      "default": {}
    }
  },
  "$defs": {
    "uuidUrn": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidV7Urn": {
      "description": "Identity of this record. Time-ordered UUIDv7, generated by the producer. Not a deduplication key: see source.event_id.",
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "multihash": {
      "type": "string",
      "pattern": "^1220[0-9a-f]{64}$",
      "description": "SHA2-256 as a hex-encoded multihash (prefix 1220), as used by the STAC File extension"
    },
    "internalRef": {
      "description": "Internal identifier only. Client-facing URLs are generated by the access layer, never stored.",
      "type": "string",
      "pattern": "^(s3|lake|urn):"
    },
    "orgUrn": {
      "type": "string",
      "pattern": "^urn:org:[a-z0-9_.-]+$"
    },
    "countryOrCoalition": {
      "description": "ISO 3166-1 alpha-3 country code, or a coalition from the maintained list.",
